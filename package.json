{
  "homepage": "./",
  "name": "lg_bbnl_ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.13.2",
    "hls.js": "^1.6.15",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.11.0",
    "react-scripts": "5.0.1",
    "react-window": "^2.2.6",
    "zustand": "^4.5.7"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "tv:package": "ares-package build/ -o .",
    "tv:install": "ares-install --device tv com.bbnl.iptv_2.0.0_all.ipk",
    "tv:launch": "ares-launch --device tv com.bbnl.iptv",
    "tv:close": "ares-launch --device tv --close com.bbnl.iptv",
    "tv:inspect": "ares-inspect --device tv com.bbnl.iptv",
    "tv:logs": "ares-log --device tv",
    "tv:uninstall": "ares-install --device tv --remove com.bbnl.iptv",
    "deploy": "npm run build && npm run tv:package && npm run tv:install && npm run tv:launch"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "Chrome >= 53",
      "last 2 Chrome versions",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
